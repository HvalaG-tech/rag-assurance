# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
MAX_TOKENS=4096
# Effort de raisonnement : low | medium | high | xhigh | max
EFFORT=medium

# --- Embeddings ---
# fastembed (défaut, ONNX, sans PyTorch) | hf (sentence-transformers) | openai
EMBEDDING_PROVIDER=fastembed
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Découpage et recherche ---
# semantic (sections du contrat, défaut) | fixed
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# hybrid (vectoriel + BM25, défaut) | vector | bm25
RETRIEVAL_MODE=hybrid
FETCH_K=20
TOP_K=5
RRF_K=60
# Reranker cross-encoder (PyTorch) : local uniquement, requiert requirements-local.txt
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Vector store ---
COLLECTION_NAME=assurance
# PERSIST_DIRECTORY=data/chroma

# --- Démo publique ---
# true : le parcours guidé sert des réponses pré-calculées, les questions libres
# exigent la clé du visiteur.
DEMO_MODE=false
MAX_QUESTIONS_PAR_SESSION=10

# --- Alternative OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
